APP_NAME="Photo Party"
APP_ENV=local
APP_KEY=
# Produção: APP_ENV=production e APP_DEBUG=false (OWASP A02).
APP_DEBUG=true
# Horários dos eventos são interpretados neste fuso.
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://photoparty.test

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

# Base do link do QR code do convidado e do telão.
PHOTOPARTY_PUBLIC_URL=https://photo.uailabs.net
PHOTOPARTY_REGISTER_PER_HOUR=5

# Senha dos usuários de demonstração criados por `php artisan db:seed` (só local).
SEED_PASSWORD="Password!123"

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=photoparty
DB_USERNAME=photoparty
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produção (HTTPS): true. Local sem HTTPS: false.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# E-mail: SMTP do Hostinger em produção; `log` no ambiente local.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@photo.uailabs.net"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
